@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Medicare Hospital Management</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Toastr CSS -->
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var role = User.FindFirstValue(ClaimTypes.Role) ?? "Patient";
        var userAvatar = User.FindFirst("ProfilePicture")?.Value ?? "/images/avatars/default.svg";
        var userName = User.Identity.Name ?? "User";
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        <div class="app-wrapper">
            <!-- Sidebar -->
            <aside class="app-sidebar" id="appSidebar">
                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
                    <img src="~/images/hospital-logo.svg" alt="Medicare Logo" />
                </a>

                <ul class="sidebar-menu">
                    <li class="menu-header">Core</li>
                    <li class="menu-item">
                        <a asp-controller="Dashboard" asp-action="Index" class="menu-link @(currentController == "Dashboard" ? "active" : "")">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>

                    <li class="menu-header">Clinical & Operations</li>
                    <li class="menu-item">
                        <a asp-controller="Appointments" asp-action="Index" class="menu-link @(currentController == "Appointments" ? "active" : "")">
                            <i class="bi bi-calendar2-check"></i>
                            <span>Appointments</span>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a asp-controller="Patients" asp-action="Index" class="menu-link @(currentController == "Patients" ? "active" : "")">
                            <i class="bi bi-people"></i>
                            <span>Patients</span>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a asp-controller="Doctors" asp-action="Index" class="menu-link @(currentController == "Doctors" ? "active" : "")">
                            <i class="bi bi-heart-pulse"></i>
                            <span>Doctors</span>
                        </a>
                    </li>

                    <li class="menu-header">Specialized Modules</li>
                    <!-- Warden / Ward Management Module -->
                    <li class="menu-item">
                        <a asp-controller="Warden" asp-action="Index" class="menu-link @(currentController == "Warden" && currentAction == "Index" ? "active" : "")">
                            <i class="bi bi-hospital"></i>
                            <span>Wards & Beds (Warden)</span>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a asp-controller="Warden" asp-action="Admissions" class="menu-link @(currentController == "Warden" && currentAction == "Admissions" ? "active" : "")">
                            <i class="bi bi-door-open"></i>
                            <span>Bed Admissions</span>
                        </a>
                    </li>

                    <!-- Nurse Station Module -->
                    <li class="menu-item">
                        <a asp-controller="Nurse" asp-action="Index" class="menu-link @(currentController == "Nurse" ? "active" : "")">
                            <i class="bi bi-activity"></i>
                            <span>Nurse Station (Vitals)</span>
                        </a>
                    </li>

                    <!-- Prescriptions Module -->
                    <li class="menu-item">
                        <a asp-controller="Prescriptions" asp-action="Index" class="menu-link @(currentController == "Prescriptions" ? "active" : "")">
                            <i class="bi bi-file-earmark-medical"></i>
                            <span>Prescriptions</span>
                        </a>
                    </li>

                    <!-- Billing & Invoices Module -->
                    <li class="menu-item">
                        <a asp-controller="Billing" asp-action="Index" class="menu-link @(currentController == "Billing" ? "active" : "")">
                            <i class="bi bi-receipt"></i>
                            <span>Billing & Invoices</span>
                        </a>
                    </li>

                    <!-- Departments Module -->
                    <li class="menu-item">
                        <a asp-controller="Departments" asp-action="Index" class="menu-link @(currentController == "Departments" ? "active" : "")">
                            <i class="bi bi-building"></i>
                            <span>Departments</span>
                        </a>
                    </li>
                </ul>

                <!-- User mini profile in Sidebar footer -->
                <div class="sidebar-user">
                    <img src="@userAvatar" alt="@userName" class="user-avatar-sm" />
                    <div class="overflow-hidden">
                        <div class="fw-bold text-truncate text-white small">@userName</div>
                        <span class="user-badge badge-@role">@role</span>
                    </div>
                </div>
            </aside>

            <!-- Main Workspace -->
            <div class="app-main">
                <!-- Topbar -->
                <header class="app-topbar">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-sm btn-light border d-lg-none" id="sidebarToggle" type="button">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <h5 class="mb-0 fw-bold text-dark d-none d-sm-block">
                            @ViewData["Title"]
                        </h5>
                    </div>

                    <!-- Right Topbar Controls -->
                    <div class="d-flex align-items-center gap-3">
                        <a asp-controller="Appointments" asp-action="Create" class="btn btn-sm btn-primary-custom d-none d-md-inline-flex">
                            <i class="bi bi-plus-circle"></i> Book Appointment
                        </a>

                        <!-- Notification Bell (Static / Aesthetic) -->
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light border rounded-circle p-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-bell text-secondary"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="width: 280px;">
                                <li class="dropdown-header fw-bold">Recent Hospital Alerts</li>
                                <li><a class="dropdown-item small py-2" href="#"><i class="bi bi-check-circle text-success me-2"></i>New patient registered</a></li>
                                <li><a class="dropdown-item small py-2" href="#"><i class="bi bi-hospital text-info me-2"></i>Bed ICU-02 disinfected</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item small text-center text-primary" href="#">View all alerts</a></li>
                            </ul>
                        </div>

                        <!-- Top User Profile & Avatar Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-light d-flex align-items-center gap-2 border rounded-pill px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="@userAvatar" alt="@userName" class="user-avatar-sm" style="width: 34px; height: 34px;" />
                                <div class="text-start d-none d-md-block pe-1">
                                    <div class="small fw-bold text-dark lh-sm">@userName</div>
                                    <span class="user-badge badge-@role" style="font-size: 0.65rem; padding: 0.1rem 0.4rem;">@role</span>
                                </div>
                                <i class="bi bi-chevron-down small text-muted"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold">@userName</div>
                                    <div class="small text-muted text-truncate">@User.FindFirstValue(ClaimTypes.Email)</div>
                                </li>
                                <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2 text-primary"></i>My Profile</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar-event me-2 text-info"></i>My Appointments</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Page Content Body -->
                <main class="app-content">
                    @RenderBody()
                </main>

                <!-- Footer -->
                <footer class="bg-white border-top py-3 px-4 text-center text-muted small">
                    &copy; 2026 Medicare Hospital Management System. Built with ASP.NET Core MVC, jQuery, and SQL.
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- Public Layout (Landing Page or Auth Pages) -->
        <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top py-2 px-3 px-md-5">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/hospital-logo.svg" alt="Medicare Hospital" height="42" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="publicNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                        <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="#services">Services</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="#doctors">Specialists</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" href="#contact">Emergency Care</a></li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-custom">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary-custom">
                            <i class="bi bi-person-plus me-1"></i> Register
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="bg-dark text-light py-4 mt-auto">
            <div class="container text-center text-md-start">
                <div class="row align-items-center">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <h6 class="text-white fw-bold mb-1">Medicare Multi-Specialty Hospital</h6>
                        <p class="text-muted small mb-0">Providing comprehensive healthcare excellence with advanced digital hospital infrastructure.</p>
                    </div>
                    <div class="col-md-6 text-md-end text-muted small">
                        &copy; 2026 Medicare HMS. ASP.NET Core &amp; SQL Server Solution.
                    </div>
                </div>
            </div>
        </footer>
    }

    <!-- jQuery, Bootstrap, and Toastr Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Configure Toastr Defaults -->
    <script>
        toastr.options = {
            "closeButton": true,
            "debug": false,
            "newestOnTop": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "preventDuplicates": false,
            "onclick": null,
            "showDuration": "300",
            "hideDuration": "1000",
            "timeOut": "4500",
            "extendedTimeOut": "1500",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };

        // Automatic Flash Message to Toastr Binding
        @if (TempData["SuccessMessage"] != null)
        {
            <text>toastr.success("@JavaScriptEncoder.Default.Encode(TempData["SuccessMessage"]?.ToString() ?? "")");</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>toastr.error("@JavaScriptEncoder.Default.Encode(TempData["ErrorMessage"]?.ToString() ?? "")");</text>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <text>toastr.info("@JavaScriptEncoder.Default.Encode(TempData["InfoMessage"]?.ToString() ?? "")");</text>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <text>toastr.warning("@JavaScriptEncoder.Default.Encode(TempData["WarningMessage"]?.ToString() ?? "")");</text>
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
